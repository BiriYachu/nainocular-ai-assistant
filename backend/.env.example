# Copy this file to ".env" and fill in the blanks. NEVER commit the real ".env" file.

PORT=5000
# The address of the React dev server (allowed to call this backend)
FRONTEND_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# Local MongoDB (default) or a MongoDB Atlas connection string. Atlas strings contain a password: keep them out of Git.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nainocular

# ---- Qdrant (the vector database that stores the embeddings) ----
# Run Qdrant locally (see the README). For Qdrant Cloud, use its URL and set QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nainocular_chunks

# ---- LLM (answers) through OpenRouter ----
OPENROUTER_API_KEY=
# Pick a chat model ID from https://openrouter.ai/models. Tested and recommended: google/gemini-2.5-flash
OPENROUTER_MODEL=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Low = less random wording. It does not guarantee factual accuracy.
LLM_TEMPERATURE=0

# ---- Embeddings ----
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
# Leave blank to reuse OPENROUTER_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# Size of every embedding. It must match the model above. Qdrant's collection is created with this size.
EMBEDDING_DIMENSIONS=1536

# ---- Retrieval ----
RETRIEVAL_TOP_K=5
# Minimum cosine similarity (-1 to 1). A starting guess, NOT calibrated: tune it with your own test questions.
RETRIEVAL_MIN_SIMILARITY=0.2

# Second LLM call that checks the answer against the quotes (true/false)
ENABLE_CLAIM_VERIFICATION=true

# ---- Rate limits (requests per minute per IP address) ----
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20

# ---- Limits (protect cost and storage) ----
# A document with more chunks than this is refused (one chunk is about 800 characters)
MAX_CHUNKS_PER_DOCUMENT=500
# How many documents one user may keep
MAX_DOCUMENTS_PER_USER=20

# ---- Provider retries ----
# If the AI provider says "too many requests" or has a temporary problem, we wait this long (in milliseconds,
# and longer after each failure) and try again, up to 3 tries in total.
PROVIDER_RETRY_DELAY_MS=1000

# ---- Hosting ----
# Set to 1 when the backend runs behind a proxy or hosting service, so rate limits work per visitor.
TRUST_PROXY=0
